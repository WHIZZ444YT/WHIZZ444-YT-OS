{
  "name": "finance-intelligence-os",
  "version": "1.1.0",
  "private": true,
  "description": "Futures-only research and education platform for exchange-listed markets and ICT Futures",
  "scripts": {
    "build": "python3 scripts/build_site.py",
    "validate": "python3 scripts/validate.py",
    "test": "python3 -m unittest discover -s tests -v",
    "audit:links": "python3 scripts/audit_internal_links.py",
    "smoke:worker": "node scripts/smoke_worker.mjs",
    "worker:dry-run": "wrangler deploy --config cloudflare/wrangler.toml --dry-run --strict --keep-vars",
    "worker:stage": "wrangler versions upload --config cloudflare/wrangler.toml --strict --keep-vars"
  },
  "devDependencies": {
    "wrangler": "4.164.0"
  }
}
